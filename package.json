{
  "name": "fastify-api-typescript-boilerplate",
  "version": "1.0.0",
  "description": "Fastify API framework with TypesScript support",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "pnpm format && pnpm lint",
    "build": "tsc",
    "prestart": "pnpm build",
    "start": "NODE_ENV=production node -r dotenv-flow/config dist/index.js",
    "dev": "NODE_ENV=development node -r dotenv-flow/config dist/index.js",
    "dev:watch": "NODE_ENV=development nodemon -r dotenv-flow/config",
    "format": "prettier --write \"src/**/*.{js,mjs,ts,json}\"",
    "lint": "eslint . --fix",
    "test": "NODE_ENV=test jest test",
    "test:coverage": "NODE_ENV=test jest --collectCoverageFrom=src/**/*.{js,ts} --coverage",
    "knip": "knip",
    "update": "ncu -i --format=group"
  },
  "keywords": [
    "fastify",
    "typescript",
    "boilerplate"
  ],
  "author": "Vladimir Poplavskij <float45@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@fastify/routes": "^6.0.2",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@sinclair/typebox": "^0.33.22",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.7.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/dotenv-flow": "^3.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.9",
    "@types/pino": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-plugin-jest": "^29.12.1",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "knip": "^5.82.1",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^19.3.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
